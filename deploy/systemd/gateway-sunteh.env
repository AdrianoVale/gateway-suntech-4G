# Copie para: /etc/default/gateway-sunteh
# Formato: CHAVE=VALOR

# Ambiente
DOTNET_ENVIRONMENT=Production

# Endpoint de metricas
Gateway__Metrics__Url=http://127.0.0.1:9054

# UDP
Gateway__Udp__Port=9040

# PostgreSQL
Gateway__PostgresDatabase__ConnectionString=Host=127.0.0.1;Database=blt_rastro_pg;Username=blt_aplicacao;Password=B1tRst@Pg#2026!Gw;Port=5432
Gateway__PostgresDatabase__ConnectTimeoutSeconds=2
Gateway__PostgresDatabase__CommandTimeoutSeconds=3
Gateway__PostgresDatabase__KeepAliveSeconds=15
Gateway__PostgresDatabase__MaxRetryAttempts=2
Gateway__PostgresDatabase__RetryBaseDelayMilliseconds=150
Gateway__PostgresDatabase__RetryMaxDelayMilliseconds=1000
Gateway__PostgresDatabase__CircuitOpenSeconds=15

# Hub SignalR (WebSocket em tempo real — descomente e configure para ativar)
Gateway__Hub__Enabled=true
Gateway__Hub__JwtSecret=191db5e842bb80692c6b520c381b55c98394b6f25af2f0d04bbe6f8675a48bf3
# Gateway__Hub__Url=http://127.0.0.1:9055
# Gateway__Hub__JwtIssuer=blt-php
# Gateway__Hub__JwtAudience=gateway-pos
# Gateway__Hub__PermissionCacheMinutes=5

# Replay
Gateway__Replay__CheckIntervalSeconds=30
Gateway__Replay__DbRetryIntervalSeconds=15

# Logging em arquivo da aplicacao
Gateway__FileLogging__Directory=log
Gateway__FileLogging__CurrentFileName=gateway-atual.log
Gateway__FileLogging__ArchivedDirectoryName=arquivados
Gateway__FileLogging__ArchiveFilePrefix=gateway
Gateway__FileLogging__RetentionDays=3
